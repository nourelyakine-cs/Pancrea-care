# Copie de configuration : renseigner les valeurs puis renommer en .env

# Database (Supabase n'héberge plus que Postgres, il ne gère plus l'authentification)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Application
ENVIRONMENT=development
APP_NAME=PANCRA

# CORS (JSON array of comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Secret de signature des jetons de session.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# L'API refuse de démarrer hors développement tant que cette valeur est celle
# par défaut : avec un secret connu, n'importe qui pourrait forger un jeton
# d'administration.
JWT_SECRET=dev-secret-a-remplacer-en-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Anti-force brute : nombre d'échecs consécutifs avant verrouillage du compte.
MAX_TENTATIVES_CONNEXION=5
DUREE_VERROUILLAGE_MINUTES=15

# Durée de validité du lien de réinitialisation que l'admin transmet au médecin.
DUREE_JETON_REINIT_MINUTES=60

# URL du frontend, utilisée pour construire les liens de réinitialisation.
FRONTEND_URL=http://localhost:3000

# Development only. Set to False in production.
# False : les routes protégées lisent réellement le jeton de session (identité du
# médecin connecté, cloisonnement des patients). True : tout est court-circuité
# sur un compte « démo » dev@local — pratique pour une démonstration sans
# compte. À ne jamais utiliser en production.
DISABLE_AUTH=False