# This is a copy of env ,just fill the passwords,and rename the file from .env.example to .env 


# Database (Supabase)
DATABASE_URL= #paste here the connection string I shared with you here 
# Application
ENVIRONMENT=development
APP_NAME=PANCRA

# JWT Authentication
SECRET_KEY= #paste here the JWT_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:3034","http://localhost:5173"]

# Frontend (used to build the reset-password link sent by email)
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Email (Resend API) for password reset emails - https://resend.com/api-keys
RESEND_API_KEY= #paste here your Resend API key
RESEND_FROM= #e.g. PANCRA <noreply@pancra.com> (must be a verified sender address)
